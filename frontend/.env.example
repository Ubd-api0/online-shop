# Frontend environment variables (CRA reads REACT_APP_* at build time).
# All of these are required except where marked optional — nothing falls back
# to localhost in code.

PORT=3030

# API base: "/api/v2" with the vercel.json proxy (keeps the auth cookie
# first-party), or the backend directly, e.g. https://your-backend.vercel.app/api/v2.
REACT_APP_API_URL=http://localhost:8000/api/v2

# Realtime chat server (deploy on Render/Railway — Socket.io is unreliable on Vercel).
REACT_APP_SOCKET_URL=http://localhost:4000
# Must match SOCKET_PATH on the socket server
REACT_APP_SOCKET_PATH=/socket.io

# Cloudinary unsigned upload
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_UPLOAD_PRESET=
REACT_APP_CLOUDINARY_FOLDER=
# Optional (official URL is the default)
# REACT_APP_CLOUDINARY_API_URL=https://api.cloudinary.com/v1_1
