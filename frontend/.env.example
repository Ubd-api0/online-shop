# Frontend environment variables (CRA reads REACT_APP_* at build time).
# Local dev needs none of these — the code falls back to localhost.

PORT=3030

# Production API base. Omit if you use the /api proxy in vercel.json (recommended,
# keeps the auth cookie first-party). Otherwise point straight at the backend:
# REACT_APP_API_URL=https://your-backend.vercel.app/api/v2

# Realtime chat server (deploy on Render/Railway — Socket.io is unreliable on Vercel).
REACT_APP_SOCKET_URL=https://your-socket-host.onrender.com

# Cloudinary unsigned upload (defaults baked in the code if unset).
REACT_APP_CLOUDINARY_CLOUD_NAME=dobivtrqy
REACT_APP_CLOUDINARY_UPLOAD_PRESET=modern-interior-and-furnitures
REACT_APP_CLOUDINARY_FOLDER=modern-interior-and-furnitures
