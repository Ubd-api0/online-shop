# Backend environment variables (set these in the Vercel project dashboard).

PORT=8000
DB_URL=mongodb+srv://user:pass@cluster.mongodb.net/shop_db

JWT_SECRET_KEY=change-me
JWT_EXPIRES=7d
ACTIVATION_SECRET=change-me

SMPT_HOST=smtp.gmail.com
SMPT_PORT=465
SMPT_MAIL=you@gmail.com
SMPT_PASSWORD=app-password

STRIPE_API_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# EasyPaisa / JazzCash — leave blank to use the built-in sandbox mock flow
EASYPAISA_STORE_ID=
EASYPAISA_API_URL=
EASYPAISA_CALLBACK_URL=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGERITY_SALT=
JAZZCASH_API_URL=
JAZZCASH_CALLBACK_URL=

# App URLs
FRONTEND_URL=http://localhost:3030
# Comma-separated allowed browser origins for CORS (empty = allow any)
CLIENT_URL=http://localhost:3030

# One-time store owner seed (npm run seed:store)
STORE_NAME=Shop
STORE_EMAIL=admin@shop.com
STORE_PASSWORD=Password@123
STORE_PHONE=3000000000
STORE_ADDRESS=Store address
STORE_ZIPCODE=00000
