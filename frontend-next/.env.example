# Copy to .env.local and fill in. Never commit real values.
# Every key, URL and path the app uses is read from here (src/lib/env.js);
# a missing required value fails with a clear "Missing environment variable" error.

# --- API ---------------------------------------------------------------------
# Base path/URL the browser calls. "/api/v2" = this app's own Route Handlers.
NEXT_PUBLIC_API_URL=/api/v2

# --- Database (MongoDB Atlas or local) -------------------------------------
DB_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DB_NAME?retryWrites=true&w=majority
# Local alternative: run `npm run db:local`, then
# DB_URL=mongodb://127.0.0.1:27017/shop_db

# --- Auth ------------------------------------------------------------------
JWT_SECRET_KEY=change-me-long-random-string
JWT_EXPIRES=90d
ACTIVATION_SECRET=change-me-another-long-random-string
# Public URL of this site (used in email links)
FRONTEND_URL=http://localhost:3000

# Google sign-in (OAuth web client). Authorized redirect URI: <FRONTEND_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override if the callback URL differs from <origin>/auth/callback
# GOOGLE_REDIRECT_URI=
# Optional: Google OAuth endpoints (official URLs are the defaults)
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# --- Email (SMTP) --------------------------------------------------------------
SMPT_HOST=smtp.gmail.com
SMPT_PORT=465
SMPT_MAIL=
SMPT_PASSWORD=

# --- Payments ------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=

EASYPAISA_STORE_ID=
EASYPAISA_API_URL=
EASYPAISA_CALLBACK_URL=

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGERITY_SALT=
JAZZCASH_API_URL=
JAZZCASH_CALLBACK_URL=

# --- Images (Cloudinary) -------------------------------------------------------
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_FOLDER=
# Optional (official URL is the default)
# NEXT_PUBLIC_CLOUDINARY_API_URL=https://api.cloudinary.com/v1_1

# --- Real-time chat (separate socket server) ------------------------------------
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Must match SOCKET_PATH in socket/.env
NEXT_PUBLIC_SOCKET_PATH=/socket.io
